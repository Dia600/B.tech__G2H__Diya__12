#include <stdio.h>

int main() {
    int num,reverse=0,digit;
    printf("enter number:");
    scanf("%d",&num);
    int n = num;
    while(num>0)
    {
        digit = num%10;
        reverse = (reverse*10)+digit;
        num = num/10;
    }
    if (n==reverse)
    {
    printf("Number is palindrome.");
    }
    else
    {
        printf("Number is not palindrome.");
    }

}
    return 0;
}

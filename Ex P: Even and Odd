#include <stdio.h>

int main() {
    int size,i ;
    printf("Enter size of an array:");
    scanf("%d",&size);
    int arr[size];
    printf("Enter %d elements of an array:\n",size);
    for (i=0; i<size; i++){
        scanf("%d",&arr[i]);}
    int count_odd = 0;
    int count_even = 0;
    for(i=0; i< size; i++){
        if ((arr[i]%2)==0){
            count_even++;
        }
        else {
            count_odd++;
        }
    }
    printf("Odd numbers:%d\n",count_odd);
    printf("Even numbers:%d\n", count_even);
 
    
    return 0;
}

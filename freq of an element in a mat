#include<stdio.h>
int main()
    {
        int m,n,a,count=0;
        printf("Enter rows:");
        scanf("%d",&m);
        printf("Enter column:");
        scanf("%d",&n);
        int mat[m][n];
        printf("Enter elements:");
        for(int i=0; i<m;i++)
        {
            for(int j=0;j<n;j++)
            {
                scanf("%d",&mat[i][j]);
            }
        }
        printf("Enter the element whose freq is to be known:");
        scanf("%d",&a);
        for(int i=0; i<m;i++)
        {
            for(int j=0;j<n;j++)
            {
                if (mat[i][j]==a)
                {
                    count++;
                }
            }
        }
        printf("Frequency of %d is: %d",a,count);
    }

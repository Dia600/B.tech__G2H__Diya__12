#include <stdio.h>
#include<math.h>

int main() {

   int size,i,sum=0;
   
   printf("Enter size of array:");
   scanf("%d", &size);
   int arr[size];
   printf("Enter elements of array:\n");
   for (i=0; i<size; i++)
   {
       scanf("%d", &arr[i]);
   }
    for (i=0; i<size; i++)
    {
        sum += arr[i];
        
    }
    float avg = (float)sum/size;
    printf("Sum of array:%d\n",sum);
    printf("Avg of array:%.2f",avg);
    
   
   return 0;
}

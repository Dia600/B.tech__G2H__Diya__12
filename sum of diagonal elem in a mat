#include <stdio.h>

int main() {
    int m,n;
    printf("Enter num of rows:");
    scanf("%d",&m);
    printf("Enter num of column:");
    scanf("%d",&n);
    int mat[m][n];
    printf("Enter the elements: ");
    for (int i =0;i<m;i++)
    {
        for (int j=0;j<n;j++)
        {
            scanf("%d",&mat[i][j]);
        }
    }
  
    int diag_sum = 0;
    for (int i =0;i<m;i++)
    {
        for (int j=0;j<n;j++)
        {
            if(i==j)
            {
                diag_sum += mat[i][j];
            }
        }
    }
    printf("The sum of diagonal elements of matrix:%d ",diag_sum);
    
    return 0;
}

#include<stdio.h>
int main()
    {
        int m,n,a,rsum,csum;
        printf("Enter rows:");
        scanf("%d",&m);
        printf("Enter column:");
        scanf("%d",&n);
        int mat[m][n];
        printf("Enter elements:");
        for(int i=0; i<m;i++)
        {
            for(int j=0;j<n;j++)
            {
                scanf("%d",&mat[i][j]);
            }
        }
        // for rows
        for(int i=0;i<m;i++)
        {
            rsum =0;
            for(int j=0;j<n;j++)
            {
                rsum += mat[i][j];
            }
            printf("Sum of row%d is:%d\n",i+1,rsum);
        }
        // for columns
        for(int j=0;j<n;j++)
        {
            csum =0;
            for(int i=0;i<m;i++)
            {
                csum += mat[i][j];
            }
            printf("Sum of column%d is:%d\n",j+1,csum);
        }
        
        return 0;
    }

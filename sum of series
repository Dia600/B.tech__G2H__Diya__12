#include <stdio.h>
#include<math.h>

int main() {

   int i,n ;
   float sum=0,next_term;
   printf("Enter n for the series (1+1/2+1/3+1/4+....+1/n):");
   scanf("%d",&n);
   for (i=1;i<=n;i++)
   
   {
       next_term = 1.0/i;
       sum += next_term;
   }
   printf("Sum of the series is : %.2f",sum);
   return 0;
}

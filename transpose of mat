#include<stdio.h>
int main()
    {
        int m,n;
        printf("Enter rows:");
        scanf("%d",&m);
        printf("Enter column:");
        scanf("%d",&n);
        int mat[m][n];
        int tmat[m][n];
        printf("Enter elements:");
        for(int i=0; i<m;i++)
        {
            for(int j=0;j<n;j++)
            {
                scanf("%d",&mat[i][j]);
                
            }
        }
        printf("transpose matrix:\n");
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                tmat[i][j]=mat[j][i];
                printf("%d ",tmat[i][j]);
            }
            printf("\n");
        }
    }
